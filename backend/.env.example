# ── TraceDoc Environment Variables ────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production

# Storage paths (relative to repo root)
DATA_DIR=../data
ORIGINALS_DIR=../data/originals
DERIVATIVES_DIR=../data/derivatives

# SQLite DB path
DATABASE_URL=sqlite+aiosqlite:///./tracedoc.db

# Max upload limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=200

# Z3 solver timeout (milliseconds)
Z3_TIMEOUT_MS=5000

# OCR settings
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MIN_CHARS_FOR_NATIVE=50

# LLM (optional - leave blank to use template fallback)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# CORS
FRONTEND_URL=http://localhost:3000

# Phoenix observability (P1 - leave blank to disable)
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006

